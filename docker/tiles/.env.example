# Nama berkas mbtiles hasil tilemaker, tersimpan di docker/tiles/data/
# (mis. indonesia.mbtiles bila kelak dibangun untuk seluruh Indonesia).
MBTILES_FILENAME=bali.mbtiles

# Port di host yang diteruskan ke TileServer-GL (container selalu listen di 8080).
# Sengaja BUKAN 8080 di host: port itu sudah dipakai Nominatim (docker/nominatim).
# CATATAN: di VPS nilai ini 8083 — port 8080, 8081, dan 8082 di sana sudah dipakai tiga
# instance Reverb (prod/staging/dev).
TILES_HOST_PORT=8081

# URL publik tempat tile server ini benar-benar bisa dicapai BROWSER. Wajib diisi di VPS
# (di belakang Nginx), akhiri dengan garis miring. Lokal boleh dibiarkan default.
TILES_PUBLIC_URL=http://localhost:8081/
