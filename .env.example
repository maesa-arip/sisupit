APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Multi-tenant subdomain (TASK_17): set ke ".sisupit.com" (titik di depan) di produksi agar
# sesi/login & flash message SELAMAT saat redirect antar-subdomain (mis. saat save laporan
# berpindah ke badung.sisupit.com). Lokal single-host: biarkan null.
SESSION_DOMAIN=null

# Domain dasar untuk resolusi tenant dari subdomain (TASK_17). Kosong = fitur pindah-subdomain
# nonaktif (single-tenant). Produksi: TENANT_BASE_DOMAIN=sisupit.com
TENANT_BASE_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Realtime / WebSocket (Laravel Reverb).
# Sejak #58 nilai untuk BROWSER dibaca RUNTIME dari REVERB_APP_KEY/HOST/PORT/SCHEME di
# bawah ini (di-inject server lewat window.REVERB_CONFIG di app.blade.php) — TIDAK perlu
# rebuild frontend saat pindah domain/environment. Kalau REVERB_APP_KEY kosong, fitur
# realtime nonaktif dengan peringatan di console (lihat echo.js).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Bind server Reverb (proses `php artisan reverb:start`).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Tujuan broadcasting client sisi server (PHP -> Reverb). Lokal: localhost:8080 http.
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# CATATAN: REVERB_HOST/PORT/SCHEME di atas dipakai DUA arah — oleh PHP saat menyiarkan
# event, DAN oleh browser lewat window.REVERB_CONFIG. Di produksi keduanya sama-sama
# domain publik + 443 + https (nginx mem-proxy /app ke REVERB_SERVER_PORT).
# Var VITE_REVERB_* sudah TIDAK dipakai lagi sejak #58 — aman dihapus dari .env lama.

# Geocoding - default menunjuk instance self-hosted Nominatim (lihat docker/nominatim/).
# Sengaja BUKAN server publik agar konfigurasi salah gagal cepat, bukan diam-diam pukul publik.
NOMINATIM_BASE_URL=http://127.0.0.1:8080
NOMINATIM_USER_AGENT="SISUPIT-Damkar/1.0 (admin@sisupit.test)"

# Routing rute jalan - default menunjuk instance self-hosted OSRM (lihat docker/osrm/).
OSRM_BASE_URL=http://127.0.0.1:5000
OSRM_USER_AGENT="SISUPIT-Damkar/1.0 (admin@sisupit.test)"

# Basemap tiles (peta Leaflet) - ditarik langsung oleh BROWSER. WAJIB diisi di tiap environment:
# cadangan di config/services.php cuma jaring pengaman (tile OSM resmi), bukan sumber produksi.
# Tile server sendiri disiapkan di docker/tiles/ (TileServer-GL) - lihat README di sana.
# MAP_TILE_URL=http://localhost:8081/styles/sisupit/{z}/{x}/{y}{r}.png?v=20260828

# Identitas penyedia sistem & versi dokumen legal (config/legal.php). Dipakai halaman publik
# Syarat & Ketentuan, Kebijakan Privasi, Pusat Bantuan, Tentang, dan Paket & Lisensi.
# LEGAL_PENYEDIA_ALAMAT WAJIB diisi sebelum dokumen dipakai untuk tanda tangan — alamat kantor
# pusat inilah yang menentukan yurisdiksi Pengadilan Negeri di klausul penyelesaian sengketa.
LEGAL_PENYEDIA_NAMA="PT Tawarin Dimana Saja"
LEGAL_PENYEDIA_EMAIL=support@sisupit.com
LEGAL_PENYEDIA_EMAIL_LEGAL=legal@tawarindimanaja.com
# LEGAL_PENYEDIA_WHATSAPP=
# LEGAL_PENYEDIA_TELEPON=
# LEGAL_PENYEDIA_ALAMAT=

# Google Sign-In. GOOGLE_CLIENT_ID adalah Web Client ID — dipakai alur OAuth redirect di
# browser DAN token native dari aplikasi Android. GOOGLE_IOS_CLIENT_ID diisi hanya bila
# aplikasi iOS dipakai: Google Sign-In di iPhone menerbitkan ID token dengan aud = iOS
# Client ID, sehingga tanpa kunci ini login Google dari iPhone selalu ditolak. Keduanya
# WAJIB berada di project Google Cloud yang SAMA (sisupit-c1e5a) — client yang tersebar di
# project berbeda memicu galat "Developer console is not set up correctly".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_REDIRECT=
# GOOGLE_IOS_CLIENT_ID=
